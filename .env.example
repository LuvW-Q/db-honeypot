# ============================================================
# 数据库蜜罐系统本地开发配置模板（复制为 .env 后使用）
# 所有口令均为 TEST-ONLY 占位，仅供隔离实验环境使用，禁止用于真实环境
# ============================================================

# MySQL 8.4 容器 / 本机实例
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 容器镜像（默认锁定 8.0；离线环境可指向本地已加载的同版本镜像）
MYSQL_IMAGE=mysql:8.0
MYSQL_ROOT_PASSWORD=TestOnly-Root-2026
HONEYPOT_MIGRATE_PASSWORD=TestOnly-Migrate-2026
HONEYPOT_APP_RW_PASSWORD=TestOnly-AppRw-2026
HONEYPOT_APP_RO_PASSWORD=TestOnly-AppRo-2026
HONEYPOT_BACKUP_PASSWORD=TestOnly-Backup-2026

# 数据库连接（按环境区分库名：honeypot_dev / honeypot_test / honeypot_demo）
MIGRATE_DATABASE_URL=mysql+asyncmy://honeypot_migrate:TestOnly-Migrate-2026@127.0.0.1:3306/honeypot_dev?charset=utf8mb4
DATABASE_URL=mysql+asyncmy://honeypot_app_rw:TestOnly-AppRw-2026@127.0.0.1:3306/honeypot_dev?charset=utf8mb4
READONLY_DATABASE_URL=mysql+asyncmy://honeypot_app_ro:TestOnly-AppRo-2026@127.0.0.1:3306/honeypot_dev?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://honeypot_migrate:TestOnly-Migrate-2026@127.0.0.1:3306/honeypot_test?charset=utf8mb4

# 诱饵服务（模拟 MySQL，默认端口 3307，避免与真实 MySQL 冲突）
HONEYPOT_HOST=127.0.0.1
HONEYPOT_PORT=3307
HONEYPOT_SERVICE_NAME=mysql-honeypot
# 预置诱饵账号（用户名:口令，逗号分隔；仅用于隔离实验）
HONEYPOT_ACCOUNTS=demo_reader:TestOnly-Decoy-01,demo_admin:TestOnly-Decoy-02
# 允许连接诱饵的客户端网段（逗号分隔 CIDR），用于模拟器安全边界
HONEYPOT_ALLOWED_CLIENT_CIDRS=127.0.0.1/32,172.28.0.0/24

# Web API 与前端
API_HOST=127.0.0.1
API_PORT=8000
WEB_DEV_PORT=5173
WEB_DIST_DIR=modules/m5-views-console/frontend/dist

# 数据保留与规则默认值
DATA_RETENTION_DAYS=30
AI_ENABLED=false

# 运行日志
LOG_LEVEL=INFO
